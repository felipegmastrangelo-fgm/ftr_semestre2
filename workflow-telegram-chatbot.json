{
  "name": "chatbot-telegram-clima",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [220, 320],
      "webhookId": "aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa",
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CRED",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "asg-queue",
              "name": "queue",
              "value": "={{ $json.message.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Capturar Entrada (Set)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 320]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Normaliza a variável 'queue' (trim, remove espaços extras, tira acentos, minúsculas e garante ,br)\nlet queue = ($json.queue || '').toString();\nqueue = queue.trim().replace(/\\s+/g, ' ');\nqueue = queue.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nif (queue && !/,\\s*br$/.test(queue)) { queue = queue + ',br'; }\nreturn { queue: queue };"
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Normalizar Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 320]
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q", "value": "={{ $json.queue }}" },
            { "name": "units", "value": "metric" },
            { "name": "lang", "value": "pt_br" },
            { "name": "appid", "value": "={{ $env.OPENWEATHER_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "OpenWeather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 320],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-status",
              "leftValue": "={{ $json.cod }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            },
            {
              "id": "cond-temp",
              "leftValue": "={{ $json.main.temp }}",
              "rightValue": "",
              "operator": { "type": "number", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Resposta valida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1020, 320]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Extrai a temperatura, arredonda e monta a mensagem final\nconst cidade = $json.name || 'sua cidade';\nconst temp = Math.round($json.main.temp);\nconst message = '🌤️ A temperatura em ' + cidade + ' é de ' + temp + '°C.';\nreturn { message: message, ok: true, cidade: cidade, temperatura: temp };"
      },
      "id": "66666666-6666-4666-8666-666666666666",
      "name": "Montar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 220]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.message }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "77777777-7777-4777-8777-777777777777",
      "name": "Enviar Sucesso",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1460, 220],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CRED",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "88888888-8888-4888-8888-888888888888",
      "name": "Enviar Erro",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1240, 460],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CRED",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Capturar Entrada (Set)", "type": "main", "index": 0 }]]
    },
    "Capturar Entrada (Set)": {
      "main": [[{ "node": "Normalizar Entrada", "type": "main", "index": 0 }]]
    },
    "Normalizar Entrada": {
      "main": [[{ "node": "OpenWeather", "type": "main", "index": 0 }]]
    },
    "OpenWeather": {
      "main": [
        [{ "node": "Resposta valida?", "type": "main", "index": 0 }],
        [{ "node": "Enviar Erro", "type": "main", "index": 0 }]
      ]
    },
    "Resposta valida?": {
      "main": [
        [{ "node": "Montar Mensagem", "type": "main", "index": 0 }],
        [{ "node": "Enviar Erro", "type": "main", "index": 0 }]
      ]
    },
    "Montar Mensagem": {
      "main": [[{ "node": "Enviar Sucesso", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
