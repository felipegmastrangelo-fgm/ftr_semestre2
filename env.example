# Variáveis de ambiente necessárias para o chatbot (NÃO comitar valores reais)

# Chave da API da OpenWeather (https://home.openweathermap.org/api_keys)
# Usada no nó HTTP Request via expressão: ={{ $env.OPENWEATHER_API_KEY }}
OPENWEATHER_API_KEY=

# Token do bot do Telegram (fornecido pelo @BotFather)
# Cadastrado como credencial "Telegram API" no n8n
TELEGRAM_BOT_TOKEN=
